---
/**
 * PhzsePromo - house promo card for Phzse (our own cycle-tracking app).
 * Not an affiliate unit: first-party product, so links are plain dofollow.
 */

export interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Want more than a one-off estimate?',
  body = 'This calculator predicts one cycle from averages. Phzse, our cycle tracking app, learns your real cycles and turns them into a daily energy forecast. Free on iPhone and Android, and your data stays on your device.',
  ctaLabel = "Try Phzse's Ovulation Calculator",
  ctaHref = 'https://phzse.com/ovulation-calculator/',
} = Astro.props;
---

<section
  class="card-elevated rounded-2xl p-8 my-12 relative overflow-hidden"
  aria-label="Phzse app"
>
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-12 -left-12 w-32 h-32 bg-teal-500/10 rounded-full blur-2xl"></div>
    <div class="absolute -bottom-12 -right-12 w-32 h-32 bg-violet-500/10 rounded-full blur-2xl">
    </div>
  </div>

  <div class="relative">
    <p class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-2">Our app</p>
    <h2 class="text-xl font-display text-[var(--color-cream)] mb-2">{heading}</h2>
    <p class="text-[var(--color-subtle)] mb-6 max-w-2xl">{body}</p>
    <a href={ctaHref} target="_blank" rel="noopener" class="btn-primary inline-flex">
      {ctaLabel}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </div>
</section>
