---
/**
 * Hero Section Component - Dark Theme
 *
 * Displays the title and description header for calculator pages.
 */
import { leadAnswer } from '../../../lib/leadAnswer';
import type { FAQ } from './FAQSection.astro';

export interface Props {
  /** Main heading (H1) */
  title: string;
  /** Subtitle/description text */
  description: string;
  /** Overrides the answer derived from faqs, when the first FAQ is not the best lead */
  quickAnswer?: string;
  /** The page's FAQ list; its first answer becomes the lead passage */
  faqs?: FAQ[];
}

const { title, description, quickAnswer, faqs } = Astro.props;
const answer = quickAnswer ?? leadAnswer(faqs?.[0]);
---

<header class="text-center mb-10">
  <h1 class="text-3xl md:text-4xl lg:text-5xl font-display text-[var(--color-cream)] mb-4">
    {title}
  </h1>
  <p class="text-xl text-[var(--color-subtle)] max-w-2xl mx-auto">
    {description}
  </p>
  {
    answer && (
      <p class="mt-6 max-w-2xl mx-auto text-left text-[var(--color-cream)] bg-white/5 border-l-2 border-[var(--color-cream)]/40 rounded-r px-4 py-3">
        {answer}
      </p>
    )
  }
</header>
