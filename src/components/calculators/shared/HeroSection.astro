---
/**
 * Hero Section Component - Dark Theme
 *
 * Displays the title and description header for calculator pages.
 */

export interface Props {
  /** Main heading (H1) */
  title: string;
  /** Subtitle/description text */
  description: string;
  /** Short numeric answer shown above the tool, for readers and AI answer engines */
  quickAnswer?: string;
}

const { title, description, quickAnswer } = Astro.props;
---

<header class="text-center mb-10">
  <h1 class="text-3xl md:text-4xl lg:text-5xl font-display text-[var(--color-cream)] mb-4">
    {title}
  </h1>
  <p class="text-xl text-[var(--color-subtle)] max-w-2xl mx-auto">
    {description}
  </p>
  {
    quickAnswer && (
      <p class="mt-6 max-w-2xl mx-auto text-left text-[var(--color-cream)] bg-white/5 border-l-2 border-[var(--color-cream)]/40 rounded-r px-4 py-3">
        {quickAnswer}
      </p>
    )
  }
</header>
