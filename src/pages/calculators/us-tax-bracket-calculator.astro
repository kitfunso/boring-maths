---
/**
 * US Tax Bracket Calculator Page
 * Federal income tax calculator with bracket visualization
 */

import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SEOHead from '../../components/common/SEOHead.astro';
import HeroSection from '../../components/calculators/shared/HeroSection.astro';
import ContentSection from '../../components/calculators/shared/ContentSection.astro';
import FAQSection from '../../components/calculators/shared/FAQSection.astro';
import SourcesSection from '../../components/calculators/shared/SourcesSection.astro';
import { USTaxBracketCalculator } from '../../components/calculators/USTaxBracketCalculator';
import { FEDERAL_BRACKETS_2026, STANDARD_DEDUCTION_2026 } from '../../lib/us-tax-2026';

const usd = (n: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(n);

const single = FEDERAL_BRACKETS_2026.single;
const singleBracketText = single
  .map((b, i) => {
    if (b.max === Infinity) return `and ${b.rate}% above that`;
    return i === 0
      ? `the ${b.rate}% bracket up to ${usd(b.max)}`
      : `${b.rate}% up to ${usd(b.max)}`;
  })
  .join(', ');
// Worked example for the "how brackets work" answer: $60,000 taxable income, single filer
const exampleIncome = 60000;
const [band1, band2, band3] = single;

const title = 'US Tax Bracket Calculator (2025, 2026): Federal Income Tax';
const description =
  'Free federal income tax bracket calculator for 2025 and 2026. See your marginal rate, effective rate, and total tax owed across all filing statuses.';
const keywords =
  'tax bracket calculator, what tax bracket am I in, federal income tax calculator 2026, marginal tax rate calculator, effective tax rate, us tax calculator';
const canonicalURL = '/calculators/us-tax-bracket-calculator';
const siteUrl = 'https://boring-math.com';

const breadcrumbs = [
  { label: 'Calculators', href: '/calculators/' },
  { label: 'US Tax Bracket Calculator' },
];

const relatedCalculators = [
  {
    title: 'Self-Employment Tax Calculator',
    description: 'Calculate 15.3% SE tax on 1099 income.',
    href: '/calculators/us-self-employment-tax-calculator/',
    icon: 'calculator' as const,
    color: 'green' as const,
  },
  {
    title: 'Capital Gains Tax Calculator',
    description: 'Calculate tax on stocks, crypto & investments.',
    href: '/calculators/us-capital-gains-tax-calculator/',
    icon: 'chart' as const,
    color: 'amber' as const,
  },
  {
    title: 'US Quarterly Tax Calculator',
    description: 'Calculate estimated quarterly tax payments.',
    href: '/calculators/us-quarterly-tax-calculator/',
    icon: 'calculator' as const,
    color: 'green' as const,
  },
];

const faqs = [
  {
    question: 'What tax bracket am I in for 2026?',
    answer: `Your tax bracket depends on your filing status and taxable income. For 2026, single filers are in ${singleBracketText}. Use our calculator to find your exact bracket, or switch it to 2025.`,
  },
  {
    question: "What's the difference between marginal and effective tax rate?",
    answer:
      'Your marginal tax rate is the rate you pay on your last dollar of income (your tax bracket). Your effective tax rate is the actual percentage of your total income that goes to taxes. Because of how tax brackets work, your effective rate is always lower than your marginal rate.',
  },
  {
    question: 'How do tax brackets actually work?',
    answer: `Tax brackets are progressive, meaning different portions of your income are taxed at different rates. For example, if you're single with ${usd(exampleIncome)} taxable income, the first ${usd(band1.max)} is taxed at ${band1.rate}%, the next ${usd(band2.max - band1.max)} at ${band2.rate}%, and the remaining ${usd(exampleIncome - band2.max)} at ${band3.rate}%. You don't pay ${band3.rate}% on your entire income.`,
  },
  {
    question: 'Should I take the standard deduction or itemize?',
    answer: `Take whichever is larger. For 2026, the standard deduction is ${usd(STANDARD_DEDUCTION_2026.single)} (single), ${usd(STANDARD_DEDUCTION_2026.married_jointly)} (married filing jointly), or ${usd(STANDARD_DEDUCTION_2026.head_of_household)} (head of household). Only itemize if your deductions exceed these amounts. Itemized deductions include mortgage interest, charitable donations, and state and local taxes up to $40,400 for 2026 ($40,000 for 2025), a cap that shrinks once income passes $505,000.`,
  },
  {
    question: 'What are the standard deductions for 2026 and 2025?',
    answer: `For 2026, the standard deduction is: ${usd(STANDARD_DEDUCTION_2026.single)} for single filers and married filing separately, ${usd(STANDARD_DEDUCTION_2026.married_jointly)} for married filing jointly, and ${usd(STANDARD_DEDUCTION_2026.head_of_household)} for head of household. For 2025, it is $15,750, $31,500, and $23,625 after the One, Big, Beautiful Bill. These amounts are automatically deducted from your gross income before calculating tax.`,
  },
  {
    question: 'Does this calculator include state taxes?',
    answer:
      'This calculator focuses on federal income tax only. State taxes vary widely: seven states have no income tax (Texas, Florida, Nevada, etc.), while others like California can add over 13% on top of federal taxes. Consider your state tax separately.',
  },
  {
    question: 'How can I lower my tax bracket?',
    answer:
      'You can reduce your taxable income by: contributing to a traditional 401(k) or IRA (up to $24,500 for 401(k) in 2026), contributing to an HSA if eligible, maximizing deductions, and timing income if self-employed. These strategies can push you into a lower bracket.',
  },
  {
    question: 'What income counts toward my tax bracket?',
    answer:
      'Your tax bracket is based on taxable income, which includes wages, salaries, tips, interest, dividends, capital gains, business income, and retirement distributions. It excludes tax-free income like municipal bond interest, Roth IRA withdrawals, and some Social Security benefits.',
  },
];

const schemaBreadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'US Tax Bracket Calculator', url: canonicalURL },
];
---

<CalculatorLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalURL={canonicalURL}
  breadcrumbs={breadcrumbs}
  relatedCalculators={relatedCalculators}
>
  <SEOHead
    slot="schema"
    name="US Tax Bracket Calculator"
    description={description}
    url={`${siteUrl}${canonicalURL}`}
    faqs={faqs}
    breadcrumbs={schemaBreadcrumbs}
  />

  <HeroSection
    title="US Tax Bracket Calculator"
    description="Find your 2025 or 2026 federal tax bracket and calculate exactly how much you owe. See the breakdown of how your income is taxed at each rate."
    faqs={faqs}
  />

  <section class="mb-16" aria-label="Calculator">
    <USTaxBracketCalculator client:load />
  </section>

  <ContentSection title="How to Use This Calculator">
    <ol class="list-decimal list-inside space-y-3 text-[var(--color-subtle)]">
      <li>
        <strong class="text-[var(--color-cream)]">Select the tax year</strong> – 2026 (the default) or
        2025.
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Select your filing status</strong> – Single, Married
        Filing Jointly, Married Filing Separately, or Head of Household.
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Enter your gross income</strong> – Your total income
        before any deductions (W-2 wages, 1099 income, etc.).
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Choose your deduction type</strong> – Standard (automatic)
        or itemized (if you have significant deductions).
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Review your results</strong> – See your tax bracket,
        federal tax owed, and visual breakdown by bracket.
      </li>
    </ol>
  </ContentSection>

  <ContentSection title="Understanding Your Results">
    <div class="space-y-4 text-[var(--color-subtle)]">
      <p>
        The <strong class="text-blue-400">federal income tax</strong> shown is what you owe the IRS based
        on the 2025 or 2026 tax brackets you select. This is before any credits (like the Child Tax Credit)
        which can reduce your final tax bill.
      </p>
      <p>
        Your <strong class="text-amber-400">marginal rate</strong> (tax bracket) is the rate on your last
        dollar of income. The <strong class="text-emerald-400">effective rate</strong> is what you actually
        pay overall, always lower than your marginal rate.
      </p>
      <p>
        The <strong class="text-[var(--color-cream)]">visual breakdown</strong> shows exactly how much
        of your income falls into each bracket and how much tax you pay at each rate. This illustrates
        how progressive taxation works.
      </p>
    </div>
  </ContentSection>

  <SourcesSection
    checked="2026-10-24"
    sources={[
      {
        label: 'IRS: IRS releases tax inflation adjustments for tax year 2026',
        href: 'https://www.irs.gov/newsroom/irs-releases-tax-inflation-adjustments-for-tax-year-2026-including-amendments-from-the-one-big-beautiful-bill',
      },
      {
        label: 'IRS: Revenue Procedure 2025-32, 2026 tax rate tables and inflation adjustments',
        href: 'https://www.irs.gov/pub/irs-drop/rp-25-32.pdf',
      },
      {
        label: 'IRS: Federal income tax rates and brackets (2025 tables)',
        href: 'https://www.irs.gov/filing/federal-income-tax-rates-and-brackets',
      },
      {
        label: 'IRS: 401(k) limit increases to $24,500 for 2026, IRA limit increases to $7,500',
        href: 'https://www.irs.gov/newsroom/401k-limit-increases-to-24500-for-2026-ira-limit-increases-to-7500',
      },
    ]}
  />

  <FAQSection faqs={faqs} />
</CalculatorLayout>
