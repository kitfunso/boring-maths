---
/**
 * UK Stamp Duty Calculator Page
 * SDLT (England/NI), LBTT (Scotland), LTT (Wales)
 */

import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SEOHead from '../../components/common/SEOHead.astro';
import HeroSection from '../../components/calculators/shared/HeroSection.astro';
import ContentSection from '../../components/calculators/shared/ContentSection.astro';
import FAQSection from '../../components/calculators/shared/FAQSection.astro';
import { UKStampDutyCalculator } from '../../components/calculators/UKStampDutyCalculator';

const title = 'UK Stamp Duty Calculator 2026/27: SDLT Rates & First-Time Buyer Relief';
const description =
  'Stamp duty on a £300,000 house in England is £5,000 (2% from £125,001-£250,000, 5% from £250,001-£300,000). First-time buyers pay £0 up to £300,000. Calculator for SDLT on residential purchases including additional dwelling surcharge.';
const keywords =
  'stamp duty calculator uk, sdlt calculator, stamp duty land tax, lbtt calculator scotland, ltt calculator wales, first time buyer stamp duty, additional property stamp duty, stamp duty 2026';
const canonicalURL = '/calculators/uk-stamp-duty-calculator';
const siteUrl = 'https://boring-math.com';

const breadcrumbs = [
  { label: 'Calculators', href: '/calculators/' },
  { label: 'UK Stamp Duty Calculator' },
];

const relatedCalculators = [
  {
    title: 'UK Mortgage Affordability Calculator',
    description: 'How much you could borrow on your income.',
    href: '/calculators/uk-mortgage-affordability-calculator/',
    icon: 'calculator' as const,
    color: 'green' as const,
  },
  {
    title: 'UK Stamp Duty Guide',
    description: 'Complete SDLT, LBTT & LTT guide 2026/27.',
    href: '/calculators/uk-tax/stamp-duty/',
    icon: 'chart' as const,
    color: 'blue' as const,
  },
  {
    title: 'Stamp Duty Calculator Scotland',
    description: 'Calculate LBTT for Scottish property purchases.',
    href: '/calculators/stamp-duty-calculator-scotland/',
    icon: 'home' as const,
    color: 'green' as const,
  },
  {
    title: 'Stamp Duty Calculator Wales',
    description: 'Calculate LTT for Welsh property purchases.',
    href: '/calculators/stamp-duty-calculator-wales/',
    icon: 'home' as const,
    color: 'teal' as const,
  },
  {
    title: 'Mortgage Calculator',
    description: 'Calculate your monthly payments.',
    href: '/calculators/mortgage-calculator/',
    icon: 'home' as const,
    color: 'green' as const,
  },
  {
    title: 'Council Tax Calculator',
    description: 'Estimate ongoing council tax after buying a property.',
    href: '/calculators/council-tax-calculator/',
    icon: 'calculator' as const,
    color: 'amber' as const,
  },
];

const faqs = [
  {
    question: 'What is Stamp Duty Land Tax (SDLT)?',
    answer:
      "Stamp Duty Land Tax is a tax you pay when buying property or land in England and Northern Ireland. The amount depends on the property price, whether you're a first-time buyer, and if it's an additional property. Different taxes apply in Scotland (LBTT) and Wales (LTT).",
  },
  {
    question: 'What are the current SDLT rates in England?',
    answer:
      'From 1 April 2025, SDLT rates are: 0% up to £125,000, 2% from £125,001-£250,000, 5% from £250,001-£925,000, 10% from £925,001-£1,500,000, and 12% above £1,500,000. First-time buyers pay 0% up to £300,000 and 5% from £300,001-£500,000 (properties up to £500,000 only).',
  },
  {
    question: 'How does first-time buyer relief work?',
    answer:
      'First-time buyers in England/NI pay no SDLT on properties up to £300,000, and 5% on the portion from £300,001-£500,000. The relief only applies to properties up to £500,000. In Scotland, first-time buyers get an increased nil-rate band of £175,000 instead of £145,000. Wales has no first-time buyer relief.',
  },
  {
    question: 'What is the additional property surcharge?',
    answer:
      "If you're buying a second home or buy-to-let property in England or Northern Ireland, you pay an extra 5% SDLT surcharge (increased from 3% in October 2024) on top of standard rates, applied to the entire purchase price. Scotland charges an 8% Additional Dwelling Supplement and Wales applies higher LTT rates instead.",
  },
  {
    question: 'Do non-UK residents pay more stamp duty?',
    answer:
      'In England and Northern Ireland, non-UK residents pay an additional 2% SDLT surcharge on top of all other rates (including the additional property surcharge if applicable) on purchases of £40,000 or more. It has been in place since April 2021. Scotland (LBTT) and Wales (LTT) have no non-resident surcharge.',
  },
  {
    question: 'What is LBTT in Scotland?',
    answer:
      'Land and Buildings Transaction Tax (LBTT) replaced SDLT in Scotland from April 2015. The rates and thresholds differ from England. Current bands are: 0% up to £145,000 (£175,000 for first-time buyers), 2% from £145,001-£250,000, 5% from £250,001-£325,000, 10% from £325,001-£750,000, and 12% above £750,000.',
  },
  {
    question: 'What is LTT in Wales?',
    answer:
      'Land Transaction Tax (LTT) replaced SDLT in Wales from April 2018. Current bands are: 0% up to £225,000, 6% from £225,001-£400,000, 7.5% from £400,001-£750,000, 10% from £750,001-£1,500,000, and 12% above £1,500,000. Wales has no first-time buyer relief.',
  },
  {
    question: 'When do I pay stamp duty?',
    answer:
      'You must pay stamp duty within 14 days of completing your property purchase. Your solicitor or conveyancer usually handles this on your behalf. Late payment incurs interest and penalties.',
  },
];

const schemaBreadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'UK Stamp Duty Calculator', url: canonicalURL },
];
---

<CalculatorLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalURL={canonicalURL}
  breadcrumbs={breadcrumbs}
  relatedCalculators={relatedCalculators}
>
  <SEOHead
    slot="schema"
    name="UK Stamp Duty Calculator"
    description={description}
    url={`${siteUrl}${canonicalURL}`}
    faqs={faqs}
    breadcrumbs={schemaBreadcrumbs}
  />

  <HeroSection
    title="UK Stamp Duty Calculator"
    description="Calculate stamp duty for property purchases in England, Scotland, and Wales. Includes first-time buyer relief, additional property surcharge, and non-resident rates (England & NI)."
  />

  <section class="mb-16" aria-label="Calculator">
    <UKStampDutyCalculator client:load />
  </section>

  <ContentSection title="How to Use This Calculator">
    <ol class="list-decimal list-inside space-y-3 text-[var(--color-subtle)]">
      <li>
        <strong class="text-[var(--color-cream)]">Enter the property price</strong> – The full purchase
        price of the property you're buying.
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Select your location</strong> – Choose England & NI
        (SDLT), Scotland (LBTT), or Wales (LTT) as rates differ.
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Choose buyer type</strong> – First-time buyer, moving
        home, or purchasing an additional property.
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Non-resident status</strong> – For England & NI only,
        toggle if you're not a UK resident (adds 2% to SDLT on purchases of £40,000 or more). Scotland
        and Wales have no non-resident surcharge.
      </li>
    </ol>
  </ContentSection>

  <ContentSection title="Understanding Your Results">
    <div class="space-y-4 text-[var(--color-subtle)]">
      <p>
        The calculator shows your <strong class="text-[var(--color-cream)]">total stamp duty</strong
        > due and the <strong class="text-[var(--color-cream)]">effective rate</strong> as a percentage
        of the property price.
      </p>
      <p>
        The <strong class="text-[var(--color-cream)]">band breakdown</strong> shows exactly how much tax
        applies at each rate tier. Stamp duty is calculated on a tiered basis – you only pay the higher
        rate on the portion of the price within that band, not the entire property value.
      </p>
      <p>
        If you're a first-time buyer, you'll see your <strong class="text-emerald-400"
          >savings</strong
        > compared to standard rates. Additional property buyers and non-residents will see their
        <strong class="text-amber-400">surcharges</strong> clearly itemized.
      </p>
    </div>
  </ContentSection>

  <FAQSection faqs={faqs} />
</CalculatorLayout>
