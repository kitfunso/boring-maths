---
/**
 * Overtime Calculator Page
 *
 * SEO-optimized page targeting: "is overtime worth it after taxes calculator"
 */

import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SEOHead from '../../components/common/SEOHead.astro';
import HeroSection from '../../components/calculators/shared/HeroSection.astro';
import ContentSection from '../../components/calculators/shared/ContentSection.astro';
import FAQSection from '../../components/calculators/shared/FAQSection.astro';
import SourcesSection from '../../components/calculators/shared/SourcesSection.astro';
import OvertimeCalculator from '../../components/calculators/OvertimeCalculator/OvertimeCalculator';

// SEO Configuration
const title = 'Free Overtime Calculator: Is Overtime Worth It After Taxes? | Boring Math';
const description =
  'Calculate your real overtime pay after taxes. See your effective hourly rate, how much you actually keep, and whether overtime is worth it for your situation.';
const keywords =
  'overtime calculator, is overtime worth it, overtime after taxes calculator, overtime pay calculator, effective overtime rate, overtime tax calculator';
const canonicalURL = '/calculators/overtime-calculator';

const siteUrl = 'https://boring-math.com';

// Breadcrumbs
const breadcrumbs = [
  { label: 'Calculators', href: '/calculators/' },
  { label: 'Overtime Calculator' },
];

// Related calculators
const relatedCalculators = [
  {
    title: 'Hourly to Salary Calculator',
    description: 'Convert hourly rates to annual salary.',
    href: '/calculators/hourly-to-salary-calculator/',
    icon: 'calculator' as const,
    color: 'green' as const,
  },
  {
    title: 'Raise Calculator',
    description: 'See the lifetime value of a salary increase.',
    href: '/calculators/raise-calculator/',
    icon: 'trending' as const,
    color: 'green' as const,
  },
  {
    title: 'US Tax Bracket Calculator',
    description: 'Find out what tax bracket you are in.',
    href: '/calculators/us-tax-bracket-calculator/',
    icon: 'calculator' as const,
    color: 'gray' as const,
  },
  {
    title: 'UK Holiday Entitlement Calculator',
    description: 'Work out statutory paid leave alongside overtime pay.',
    href: '/calculators/uk-holiday-entitlement-calculator/',
    icon: 'calculator' as const,
    color: 'green' as const,
  },
];

// FAQ data
const faqs = [
  {
    question: 'Is overtime taxed at a higher rate?',
    answer:
      "Not exactly. Overtime isn't taxed at a special higher rate. However, the extra income can push you into a higher marginal tax bracket, so you may pay more tax on that additional income. Together, federal tax, state tax and FICA often take 20-40% of overtime pay. For 2025 to 2028, US workers can also deduct the half-time premium the FLSA requires (up to $12,500, or $25,000 on a joint return) from federal income tax, and this calculator includes that.",
  },
  {
    question: 'Why does my overtime paycheck seem smaller than expected?',
    answer:
      "Your employer withholds taxes based on annualized income. When you earn overtime, the payroll system assumes you'll earn that much every pay period, so it withholds more. You may get some back as a tax refund, but the net effect is that overtime is taxed at your marginal rate.",
  },
  {
    question: "What's the law on overtime pay?",
    answer:
      "In the US, the Fair Labor Standards Act (FLSA) requires non-exempt employees to receive 1.5x their regular rate for hours worked over 40 in a workweek. Some states have additional requirements. Exempt employees (salaried) typically don't receive overtime pay.",
  },
  {
    question: 'How much of my overtime do I actually keep?',
    answer:
      'It depends on your tax situation, but many people keep 60-80% of their overtime pay. Federal income tax (10-37%), state income tax (0-13%), Social Security (6.2%), and Medicare (1.45%) all take a cut, though the federal overtime deduction shelters the half-time premium from income tax. In the UK, income tax and National Insurance (8%, or 2% above £50,270) take the cut. Use our calculator to see your exact amount.',
  },
  {
    question: 'Does overtime affect my tax bracket?',
    answer:
      'It can. If overtime pushes your annual income into a higher bracket, the portion above the bracket threshold is taxed at the higher rate. But remember: only the income above the threshold is taxed higher, not all your income. This is how marginal tax brackets work.',
  },
  {
    question: 'When is overtime not worth it?',
    answer:
      "Consider if overtime isn't worth it when: (1) your effective after-tax rate is close to or below your regular rate, (2) it significantly impacts your health or relationships, (3) you could earn more per hour doing something else, or (4) the extra income pushes you into benefit phase-outs (like student loan repayment plans).",
  },
  {
    question: 'How do I maximize my overtime pay?',
    answer:
      "In the US, the federal overtime deduction (2025 to 2028) already removes income tax on the required half-time premium, up to $12,500 ($25,000 joint), with less above $150,000 of income ($300,000 joint). Beyond that you can: (1) contribute more to pre-tax retirement accounts to lower your taxable income, (2) time overtime to avoid income spikes that trigger higher withholding, (3) adjust your W-4 if you're over-withholding, (4) use HSA contributions if eligible.",
  },
  {
    question: 'Is double time better than time and a half?',
    answer:
      "Yes, but not twice as good after taxes. With this calculator's defaults ($25/hr, $52,000 a year, single, 5% state tax), time and a half pays $37.50/hr gross and about $30/hr net. Double time pays $50/hr gross and about $38/hr net. Only the half-time premium qualifies for the federal overtime deduction, so the extra half hour of pay is fully taxed.",
  },
];

// SEO schema breadcrumbs
const schemaBreadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'Overtime Calculator', url: canonicalURL },
];
---

<CalculatorLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalURL={canonicalURL}
  breadcrumbs={breadcrumbs}
  relatedCalculators={relatedCalculators}
>
  <!-- Schema.org Markup -->
  <SEOHead
    slot="schema"
    name="Overtime Calculator"
    description={description}
    url={`${siteUrl}${canonicalURL}`}
    faqs={faqs}
    breadcrumbs={schemaBreadcrumbs}
  />

  <!-- Hero Section -->
  <HeroSection
    title="Is Overtime Worth It?"
    description="Find out what your overtime really pays after taxes. See your effective hourly rate and decide if the extra hours are worth your time."
    faqs={faqs}
  />

  <!-- Calculator Component -->
  <section class="mb-16" aria-label="Calculator">
    <OvertimeCalculator client:load />
  </section>

  <!-- How to Use Section -->
  <ContentSection title="How to Use This Calculator">
    <p>
      Enter your <strong>regular hourly rate</strong> - this is your base pay before overtime multipliers
      apply.
    </p>
    <p>
      Add your <strong>current annual income</strong> before any overtime. This determines your tax bracket
      and how overtime income will be taxed.
    </p>
    <p>
      Use the slider to set how many <strong>overtime hours per week</strong> you're considering. The
      calculator assumes you work overtime consistently throughout the year.
    </p>
    <p>
      Select your <strong>overtime rate</strong> - most employers pay time and a half (1.5x), but some
      pay double time (2x) for weekends or holidays.
    </p>
    <p>
      For US users, set your <strong>filing status</strong> and <strong>state tax rate</strong> for accurate
      calculations. Enable FICA to include Social Security and Medicare taxes. US results apply the 2026
      standard deduction and the federal overtime deduction for the half-time premium. UK results use
      the 2026/27 income tax bands and include National Insurance.
    </p>
  </ContentSection>

  <!-- Understanding Results Section -->
  <ContentSection title="Understanding Your Results">
    <p>
      The <strong>effective hourly rate</strong> is the key number - it shows what you actually earn per
      overtime hour after all taxes are deducted.
    </p>
    <p>
      Compare your <strong>gross vs net overtime</strong> to see how much goes to taxes. The visual bar
      shows what percentage you keep.
    </p>
    <p>
      The <strong>tax impact</strong> section shows your current bracket and whether overtime pushes you
      into a higher one. Don't panic if it does - only the excess is taxed at the higher rate.
    </p>
    <p>
      Use the <strong>hours needed</strong> section to quickly see how many overtime hours you need for
      specific financial goals like an extra $500 or $1,000.
    </p>
  </ContentSection>

  <!-- FAQ Section -->
  <SourcesSection
    checked="2026-10-25"
    sources={[
      {
        label: 'IRS: What to know about the No Tax on Overtime deduction',
        href: 'https://www.irs.gov/newsroom/what-to-know-about-the-no-tax-on-overtime-deduction',
      },
      {
        label: 'Cornell LII: 26 U.S. Code section 225, qualified overtime compensation',
        href: 'https://www.law.cornell.edu/uscode/text/26/225',
      },
      {
        label: 'IRS: Tax inflation adjustments for tax year 2026',
        href: 'https://www.irs.gov/newsroom/irs-releases-tax-inflation-adjustments-for-tax-year-2026-including-amendments-from-the-one-big-beautiful-bill',
      },
      {
        label: 'SSA: Contribution and Benefit Base',
        href: 'https://www.ssa.gov/oact/cola/cbb.html',
      },
      {
        label: 'GOV.UK: Income Tax rates and Personal Allowances',
        href: 'https://www.gov.uk/income-tax-rates',
      },
      {
        label: 'GOV.UK: National Insurance, how much you pay',
        href: 'https://www.gov.uk/national-insurance/how-much-you-pay',
      },
    ]}
  />

  <FAQSection faqs={faqs} />
</CalculatorLayout>
