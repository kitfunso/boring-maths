---
/**
 * UK Council Tax Calculator Page
 */

import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SEOHead from '../../components/common/SEOHead.astro';
import HeroSection from '../../components/calculators/shared/HeroSection.astro';
import ContentSection from '../../components/calculators/shared/ContentSection.astro';
import FAQSection from '../../components/calculators/shared/FAQSection.astro';
import SourcesSection from '../../components/calculators/shared/SourcesSection.astro';
import { CouncilTaxCalculator } from '../../components/calculators/CouncilTaxCalculator';

const title = 'Free Council Tax Calculator: Estimate Your Annual Bill | Boring Math';
const description =
  'Free UK council tax calculator. Estimate your annual council tax by property band and region. Includes single person discount and second home premium calculations.';
const keywords =
  'council tax calculator, council tax bands, council tax 2026, council tax by postcode, council tax band calculator, single person discount council tax, second home council tax';
const canonicalURL = '/calculators/council-tax-calculator';
const siteUrl = 'https://boring-math.com';

const breadcrumbs = [
  { label: 'Calculators', href: '/calculators/' },
  { label: 'Council Tax Calculator' },
];

const relatedCalculators = [
  {
    title: 'UK Stamp Duty Calculator',
    description: 'Calculate SDLT, LBTT, or LTT on property purchases.',
    href: '/calculators/uk-stamp-duty-calculator/',
    icon: 'home' as const,
    color: 'blue' as const,
  },
  {
    title: 'UK £100k Tax Trap',
    description: 'Escape the 60% marginal tax rate.',
    href: '/calculators/uk-100k-tax-trap-calculator/',
    icon: 'chart' as const,
    color: 'red' as const,
  },
  {
    title: 'Mortgage Calculator',
    description: 'Calculate your monthly mortgage payments.',
    href: '/calculators/mortgage-calculator/',
    icon: 'calculator' as const,
    color: 'green' as const,
  },
  {
    title: 'Buy vs Rent Calculator',
    description: 'Compare the true costs of buying vs renting.',
    href: '/calculators/buy-vs-rent-calculator/',
    icon: 'home' as const,
    color: 'teal' as const,
  },
];

const faqs = [
  {
    question: 'How is council tax calculated?',
    answer:
      'Council tax is based on the valuation band of your property (A to H, or A to I in Wales) and the Band D rate set by your local council. Each band has a fixed ratio to Band D: Band A is 6/9ths, Band B is 7/9ths, up to Band H which is 2× the Band D rate. Scotland uses higher ratios for Bands E to H, so its Band H is 882/360, about 2.45× Band D. Your council sets the Band D rate annually based on its spending needs.',
  },
  {
    question: 'What are the council tax bands?',
    answer:
      'In England, properties are banded A–H based on their value on 1 April 1991. Band A: up to £40,000, Band B: £40,001–£52,000, Band C: £52,001–£68,000, Band D: £68,001–£88,000, Band E: £88,001–£120,000, Band F: £120,001–£160,000, Band G: £160,001–£320,000, Band H: over £320,000. Scotland also uses 1991 values but with lower ranges (Band H is over £212,000). Wales uses 1 April 2003 values and has a ninth band, Band I, for homes over £424,000.',
  },
  {
    question: 'What is the single person discount?',
    answer:
      'If you are the only adult living in a property (not counting students, carers, or severely mentally impaired people), you qualify for a 25% discount on your council tax. You need to apply to your local council to receive this discount.',
  },
  {
    question: 'What is the second home council tax premium?',
    answer:
      'From April 2025, councils in England can charge up to 100% extra council tax on second homes (doubling the bill). This is enabled by the Levelling Up and Regeneration Act 2023. Scottish councils can also charge up to 100% extra. In Wales the cap has been 300% since April 2023, so a second home can pay up to four times the standard bill. This calculator applies a 100% premium; check your own council for its rate.',
  },
  {
    question: 'Can I challenge my council tax band?',
    answer:
      'Yes, you can challenge your council tax band if you believe your property is in the wrong band. Contact the Valuation Office Agency (VOA) in England and Wales, or the Scottish Assessors Association in Scotland. Check similar properties in your area on the VOA website for comparison.',
  },
  {
    question: 'Are there other council tax discounts available?',
    answer:
      'Yes. Full-time students get 100% exemption. Properties left empty may get discounts (though many councils now charge premiums on long-term empty homes). People with disabilities may get a reduction, and council tax support (formerly council tax benefit) is available for people on low incomes.',
  },
  {
    question: 'How do I pay council tax?',
    answer:
      'Council tax is usually paid in 10 monthly instalments from April to January, though you can request to pay over 12 months. Payment methods include direct debit, online banking, and at the Post Office. Most councils offer a discount for paying the full year upfront.',
  },
];

const schemaBreadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'Council Tax Calculator', url: canonicalURL },
];
---

<CalculatorLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalURL={canonicalURL}
  breadcrumbs={breadcrumbs}
  relatedCalculators={relatedCalculators}
>
  <SEOHead
    slot="schema"
    name="Council Tax Calculator"
    description={description}
    url={`${siteUrl}${canonicalURL}`}
    faqs={faqs}
    breadcrumbs={schemaBreadcrumbs}
  />

  <HeroSection
    title="Council Tax Calculator"
    description="Estimate your annual council tax based on your property band and council region. Includes single person discount and second home premium."
    faqs={faqs}
  />

  <section class="mb-16" aria-label="Calculator">
    <CouncilTaxCalculator client:load />
  </section>

  <ContentSection title="How to Use This Calculator">
    <ol class="list-decimal list-inside space-y-3 text-[var(--color-subtle)]">
      <li>
        <strong class="text-[var(--color-cream)]">Select your property band</strong> – Bands A to H based
        on your property's 1991 valuation (Bands A to I and 2003 values in Wales).
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Choose your region</strong> – Average rates vary significantly
        across UK regions.
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Apply discounts</strong> – Toggle single person discount
        if you're the only adult resident.
      </li>
      <li>
        <strong class="text-[var(--color-cream)]">Check second home status</strong> – Second homes may
        face a premium of up to 100% in England (from April 2025) and Scotland, or up to 300% in Wales.
        The calculator applies 100%.
      </li>
    </ol>
  </ContentSection>

  <ContentSection title="Understanding Council Tax Bands">
    <div class="space-y-4 text-[var(--color-subtle)]">
      <p>
        Council tax bands are based on <strong class="text-[var(--color-cream)]"
          >property values as of 1 April 1991</strong
        >
        in England and Scotland (1 April 2003 in Wales). The banding system means your tax isn't directly
        proportional to your property's current value.
      </p>
      <p>
        The <strong class="text-[var(--color-cream)]">Band D rate</strong> is the reference point. In
        England, Band A pays two-thirds of Band D and Band H pays double, so the most expensive band pays
        only 3 times the cheapest, despite massive differences in property values. Scotland raised its
        Band E to H ratios in 2017, so a Scottish Band H home pays about 2.45 times Band D and about 3.7
        times Band A. Welsh Band I pays 21/9 of Band D, 3.5 times Band A.
      </p>
      <p>
        <strong class="text-emerald-400">Regional variation</strong> is significant – London tends to
        have lower council tax rates despite higher property values, while northern councils and rural
        areas often charge more due to different funding models.
      </p>
      <p>
        The 2026/27 Band D figures for England, London, Scotland and Wales are the official averages
        published by each government. The other English regions use the simple average of each
        council's Band D in that region, from the MHCLG Band D tables. Scottish figures exclude
        water and sewerage charges. Your own council's Band D can be a few hundred pounds either
        side of the average.
      </p>
    </div>
  </ContentSection>

  <SourcesSection
    checked="2026-10-24"
    sources={[
      {
        label: 'GOV.UK: Council Tax levels set by local authorities in England 2026 to 2027',
        href: 'https://www.gov.uk/government/statistics/council-tax-levels-set-by-local-authorities-in-england-2026-to-2027',
      },
      {
        label: 'GOV.UK: Live tables on Council Tax (Band D by council)',
        href: 'https://www.gov.uk/government/statistical-data-sets/live-tables-on-council-tax',
      },
      {
        label: 'Scottish Government: Council Tax datasets (Council Tax by band 2026-27)',
        href: 'https://www.gov.scot/publications/council-tax-datasets/',
      },
      {
        label: 'Welsh Government: Council tax levels, April 2026 to March 2027',
        href: 'https://www.gov.wales/council-tax-levels-april-2026-march-2027-html',
      },
      {
        label: 'GOV.UK: How domestic properties are assessed for Council Tax bands',
        href: 'https://www.gov.uk/guidance/understand-how-council-tax-bands-are-assessed',
      },
      {
        label: 'GOV.UK: How Council Tax works: Second homes and empty properties',
        href: 'https://www.gov.uk/council-tax/second-homes-and-empty-properties',
      },
    ]}
  />

  <FAQSection faqs={faqs} />
</CalculatorLayout>
