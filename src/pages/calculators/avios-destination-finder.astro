---
/**
 * Avios Destination Finder Page
 *
 * SEO-optimized page targeting: "where can I go with my avios", "avios destination finder"
 */

import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import SEOHead from '../../components/common/SEOHead.astro';
import HeroSection from '../../components/calculators/shared/HeroSection.astro';
import ContentSection from '../../components/calculators/shared/ContentSection.astro';
import FAQSection from '../../components/calculators/shared/FAQSection.astro';
import AviosDestinationFinder from '../../components/calculators/AviosDestinationFinder/AviosDestinationFinder';
import { DESTINATIONS } from '../../components/calculators/AviosDestinationFinder/data/destinations';
import { DATA_LAST_VERIFIED } from '../../components/calculators/AviosDestinationFinder/data/peakCalendar';
import { NOT_OFFERED } from '../../components/calculators/AviosDestinationFinder/types';
import type {
  Destination,
  SeasonalAvios,
} from '../../components/calculators/AviosDestinationFinder/types';

// ---------------------------------------------------------------------------
// Build-time pricing data for the static (crawlable) tables and FAQs below.
// Single source of truth: the same verified dataset the calculator uses, so
// the server-rendered numbers can never drift from the interactive ones.
// ---------------------------------------------------------------------------

const nf = new Intl.NumberFormat('en-GB');
const fmtCash = (n: number): string => (Number.isInteger(n) ? `£${n}` : `£${n.toFixed(2)}`);

const cabin = (c: Destination['economy']): SeasonalAvios | null => (c === NOT_OFFERED ? null : c);

function byCity(city: string): Destination {
  const found = DESTINATIONS.find((d) => d.city === city);
  if (!found) throw new Error(`avios-destination-finder page: unknown city "${city}"`);
  return found;
}

function econOf(city: string): SeasonalAvios {
  const e = cabin(byCity(city).economy);
  if (!e) throw new Error(`avios-destination-finder page: no economy pricing for "${city}"`);
  return e;
}

const POPULAR_CITIES = [
  'Amsterdam',
  'Paris',
  'Malaga',
  'Athens',
  'Istanbul',
  'Dubai',
  'New York',
  'Orlando',
  'Barbados',
  'Tokyo',
  'Singapore',
  'Sydney',
];
const popularRows = POPULAR_CITIES.map(byCity);

const nyEcon = econOf('New York');
const sydEcon = econOf('Sydney');
const sydBiz = cabin(byCity('Sydney').business);

const shortHaulEcon = DESTINATIONS.map((d) => cabin(d.economy)).filter(
  (e): e is SeasonalAvios => e !== null && e.cash === 1
);
const shortHaulMinOffPeak = Math.min(...shortHaulEcon.map((e) => e.offPeak));
const shortHaulMaxPeak = Math.max(...shortHaulEcon.map((e) => e.peak));

// SEO Configuration
const title = 'Avios Destination Finder (Unofficial) | Boring Math';
const description =
  'See every British Airways destination your Avios can reach. Search by points budget, dates, region and holiday type. Free unofficial guide.';
const keywords =
  'where can I go with my avios, avios destination finder, 50000 avios where can I fly, avios flights from london, companion voucher destinations, BA reward flight guide, avios peak off-peak calculator';
const canonicalURL = '/calculators/avios-destination-finder';

const siteUrl = 'https://boring-math.com';

// Breadcrumbs
const breadcrumbs = [
  { label: 'Calculators', href: '/calculators/' },
  { label: 'Avios Destination Finder' },
];

// Related calculators
const relatedCalculators = [
  {
    title: 'Vacation Budget Calculator',
    description: 'Plan and budget your vacation including flights, hotels, food, and activities.',
    href: '/calculators/vacation-budget-calculator/',
    icon: 'calendar' as const,
    color: 'ocean' as const,
  },
  {
    title: 'Tipping Guide Calculator',
    description: 'Look up tipping customs for 12 countries and 6 service types before you travel.',
    href: '/calculators/tipping-guide-calculator/',
    icon: 'users' as const,
    color: 'blue' as const,
  },
  {
    title: 'Currency Converter',
    description: 'Convert between world currencies with live exchange rates.',
    href: '/calculators/currency-converter/',
    icon: 'swap' as const,
    color: 'green' as const,
  },
];

// FAQ data
const faqs = [
  {
    question: 'Is this an official British Airways tool?',
    answer:
      'No. This is an independent, unofficial guide and is not affiliated with British Airways. Avios is a trademark of its owner. Always check live reward seat availability and final pricing on ba.com before booking.',
  },
  {
    question: 'How accurate are the prices shown?',
    answer:
      "Prices come from BA's published Reward Flight Saver table, reflecting the update from 15 December 2025, and are shown as the lowest-cash combination for each route and cabin. British Airways also sells combinations with fewer Avios and more cash on ba.com. The calendar data behind this tool was last verified on the date shown inside the calculator.",
  },
  {
    question: 'What are peak and off-peak dates?',
    answer:
      'British Airways splits the year into off-peak and peak periods and publishes the calendar in advance. The same route and cabin costs more Avios on peak dates than off-peak dates. Enter your travel dates in the finder to see which price applies to your trip.',
  },
  {
    question: 'How does the companion voucher work?',
    answer:
      'A BA American Express companion voucher gives a second seat for no extra Avios on British Airways, Iberia, or Aer Lingus reward bookings made through BA channels, not codeshares. Taxes, fees and charges are still payable for both passengers. The free BA Amex card voucher covers economy only and lasts one year; the Premium Plus voucher covers all cabins and lasts two years, both after £15,000 of card spend in a year.',
  },
  {
    question: "Why isn't my cabin offered to some destinations?",
    answer:
      'Short-haul British Airways routes have no Premium Economy cabin, so those destinations show as unavailable when Premium Economy is selected. This tool also does not cover First class.',
  },
  {
    question: 'Do Avios cover the whole cost of a reward flight?',
    answer:
      'No. Every reward booking also has a cash element for taxes, fees and charges, shown alongside the Avios total. Short-haul economy starts from £1 each way and short-haul business starts from £15 each way, per the published table. With a companion voucher, the cash element is still payable for both passengers even though the second seat is Avios-free.',
  },
  {
    question: 'Can I book flights through this tool?',
    answer:
      'No. This is a guide-price search tool only, not a booking site. Once you have a shortlist, check real-time reward seat availability and complete your booking on ba.com.',
  },
  {
    question: 'How many Avios do I need to fly from London to New York?',
    answer: `One-way in economy, New York costs ${nf.format(nyEcon.offPeak)} Avios off-peak or ${nf.format(nyEcon.peak)} Avios peak, plus ${fmtCash(nyEcon.cash)} in cash each way at the lowest-cash combination. A return for two travellers with a companion voucher needs the Avios of one return: ${nf.format(nyEcon.offPeak * 2)} off-peak, with taxes and fees payable for both passengers.`,
  },
  {
    question: 'How many Avios do I need for a short-haul flight to Europe?',
    answer: `Short-haul economy reward flights from London start at ${nf.format(shortHaulMinOffPeak)} Avios one-way off-peak plus £1 in cash, rising to ${nf.format(shortHaulMaxPeak)} Avios on peak dates for the longest short-haul routes. Use the finder above to see the exact figure for each city.`,
  },
  {
    question: 'How many Avios do I need to fly to Australia?',
    answer: `Sydney costs ${nf.format(sydEcon.offPeak)} Avios one-way off-peak in economy (${nf.format(sydEcon.peak)} peak) plus ${fmtCash(sydEcon.cash)} in cash each way${sydBiz ? `, or ${nf.format(sydBiz.offPeak)} Avios one-way off-peak in business` : ''}. These are the longest, most Avios-expensive routes on the BA network.`,
  },
];

// SEO schema breadcrumbs
const schemaBreadcrumbs = [
  { name: 'Calculators', url: '/calculators' },
  { name: 'Avios Destination Finder', url: canonicalURL },
];
---

<CalculatorLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalURL={canonicalURL}
  breadcrumbs={breadcrumbs}
  relatedCalculators={relatedCalculators}
>
  <!-- Schema.org Markup -->
  <SEOHead
    slot="schema"
    name="Avios Destination Finder"
    description={description}
    url={`${siteUrl}${canonicalURL}`}
    faqs={faqs}
    breadcrumbs={schemaBreadcrumbs}
    howToSteps={[
      {
        name: 'Enter your Avios budget',
        text: 'Type in how many Avios you have to spend on a reward flight.',
      },
      {
        name: 'Pick dates and filters',
        text: 'Optionally set travel dates, then filter by region, holiday type, cabin, travellers, and companion voucher.',
      },
      {
        name: 'Review the ranked list',
        text: 'See every matching BA destination ranked by Avios cost, with off-peak and peak prices and the cash element shown.',
      },
      {
        name: 'Check availability on ba.com',
        text: 'These are guide prices only - confirm live reward seat availability and final pricing with British Airways before booking.',
      },
    ]}
    estimatedTime="PT2M"
  />

  <!-- Hero Section -->
  <HeroSection
    title="Avios Destination Finder"
    description="See every British Airways destination your Avios can reach, filtered by budget, dates, region, and holiday type."
  />

  <!-- Calculator Component -->
  <section class="mb-16" aria-label="Calculator">
    <AviosDestinationFinder client:load />
  </section>

  <!-- How to Use Section -->
  <ContentSection title="How to Use This Calculator">
    <p>
      Enter the number of <strong>Avios</strong> you have to spend, then optionally set a travel
      <strong>date range</strong>. Reward flights price differently depending on whether your dates
      fall in BA's off-peak or peak calendar, which the airline publishes each year.
    </p>
    <p>
      Narrow the list by <strong>region</strong> and <strong>holiday type</strong>, choose your
      <strong>cabin</strong> (economy, premium economy, or business), and set how many
      <strong>travellers</strong> are going. If you hold a BA Amex <strong>companion voucher</strong
      >, toggle it on to see the difference it makes to the Avios total.
    </p>
    <p>
      The results table ranks every matching destination by Avios cost, showing off-peak and peak
      prices side by side plus the cash element that is always payable on top. This tool shows guide
      prices only, not live seat availability - once you have a shortlist, check availability and
      final pricing on ba.com before booking.
    </p>
  </ContentSection>

  <!-- How BA Prices Reward Flights -->
  <ContentSection title="How BA Prices Reward Flights">
    <p>
      British Airways prices reward flights from a fixed, published Avios table rather than dynamic
      pricing. Each destination has separate off-peak and peak prices, and BA publishes the
      peak/off-peak calendar for the year in advance. The prices shown here reflect BA's published
      table following the 15 December 2025 update.
    </p>
    <p>
      Every figure in this tool is one-way from London, quoted at the lowest-cash Reward Flight
      Saver combination for that route and cabin. British Airways also sells combinations with fewer
      Avios and more cash for the same route - check ba.com for the full range of options.
    </p>
    <p>
      As a guide to scale: short-haul economy reward flights start from 10,000 Avios plus £1 in cash
      each way (Amsterdam, off-peak), and short-haul business starts from £15 each way in cash.
      Long-haul examples range from around 27,500 Avios plus £60 one-way (New York, off-peak
      economy) up to 55,000 Avios plus £160 one-way (Sydney, off-peak economy). Short-haul routes
      have no Premium Economy cabin, and this tool does not cover First class.
    </p>
  </ContentSection>

  <!-- Static price tables: server-rendered from the same verified dataset the
       calculator uses, so search engines and answer engines can read the data
       without executing the interactive island. -->
  <ContentSection title="Avios Prices from London: Popular Destinations">
    <p>
      One-way guide prices per person at the lowest-cash Reward Flight Saver combination, from BA's
      published table (last verified {DATA_LAST_VERIFIED}). The cash element is payable per person
      each way; peak and off-peak dates follow BA's published calendar.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="sr-only">
          Avios prices one-way from London for popular British Airways destinations
        </caption>
        <thead>
          <tr class="text-[var(--color-muted)] text-xs uppercase tracking-wider">
            <th scope="col" class="text-left py-2">Destination</th>
            <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">Economy off-peak</th>
            <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">Economy peak</th>
            <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">Business off-peak</th>
            <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">+ cash from</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {
            popularRows.map((d) => {
              const e = cabin(d.economy);
              const b = cabin(d.business);
              return (
                <tr>
                  <td class="py-2">
                    {d.city} <span class="text-[var(--color-muted)]">{d.country}</span>
                  </td>
                  <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                    {e ? nf.format(e.offPeak) : '-'}
                  </td>
                  <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                    {e ? nf.format(e.peak) : '-'}
                  </td>
                  <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                    {b ? nf.format(b.offPeak) : '-'}
                  </td>
                  <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                    {e ? fmtCash(e.cash) : '-'}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <details class="mt-6">
      <summary class="cursor-pointer font-semibold">
        Full A-Z Avios price list: all {DESTINATIONS.length} destinations
      </summary>
      <p class="mt-3">
        Economy and business one-way prices for every BA destination in this tool. The cash column
        is the economy lowest-cash element per person each way; business carries a higher cash
        element. Premium Economy (long-haul only) and per-party totals are in the finder above.
      </p>
      <div class="overflow-x-auto mt-3">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Full list of Avios prices one-way from London for all British Airways destinations
          </caption>
          <thead>
            <tr class="text-[var(--color-muted)] text-xs uppercase tracking-wider">
              <th scope="col" class="text-left py-2">Destination</th>
              <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">Economy off-peak</th>
              <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">Economy peak</th>
              <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">Business off-peak</th>
              <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">Business peak</th>
              <th scope="col" class="text-right py-2 pl-3 whitespace-nowrap">+ cash from</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            {
              DESTINATIONS.map((d) => {
                const e = cabin(d.economy);
                const b = cabin(d.business);
                return (
                  <tr>
                    <td class="py-2">
                      {d.city} <span class="text-[var(--color-muted)]">{d.country}</span>
                    </td>
                    <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                      {e ? nf.format(e.offPeak) : '-'}
                    </td>
                    <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                      {e ? nf.format(e.peak) : '-'}
                    </td>
                    <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                      {b ? nf.format(b.offPeak) : '-'}
                    </td>
                    <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                      {b ? nf.format(b.peak) : '-'}
                    </td>
                    <td class="text-right py-2 pl-3 tabular-nums whitespace-nowrap">
                      {e ? fmtCash(e.cash) : '-'}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </details>
  </ContentSection>

  <!-- Companion Voucher Explainer -->
  <ContentSection title="How the Companion Voucher Works">
    <p>
      A BA American Express companion voucher gives you a second seat for no extra Avios on British
      Airways, Iberia, or Aer Lingus reward bookings made directly through BA's own channels - it
      does not apply to codeshare flights. Taxes, fees and charges remain payable for both
      passengers.
    </p>
    <p>
      The free BA Amex card's voucher covers economy only and is valid for one year, issued after
      £15,000 of card spend in a year. The Premium Plus voucher covers all cabins and is valid for
      two years, for the same level of annual spend. A solo 50% discount option also exists on some
      bookings, but this tool does not model it - toggle the voucher on above to see how it changes
      the Avios total for two travellers.
    </p>
  </ContentSection>

  <!-- FAQ Section -->
  <FAQSection faqs={faqs} />
</CalculatorLayout>
