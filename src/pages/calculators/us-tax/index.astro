---
/**
 * US Tax Calculators Hub Page
 *
 * SEO-optimized category page for US-specific tax calculators.
 * Targets: "us tax calculator", "federal tax calculator", "irs tax calculator"
 */

import CategoryLayout from '../../../layouts/CategoryLayout.astro';
import {
  FEDERAL_BRACKETS_2026,
  FEDERAL_TAX_YEAR,
  SOCIAL_SECURITY_WAGE_BASE_2026,
  STANDARD_DEDUCTION_2026,
} from '../../../lib/us-tax-2026';

const category = 'US Tax';
const title = 'US Tax Calculators | Free Federal Tax Tools';
const description = `Free US tax calculators for ${FEDERAL_TAX_YEAR}. Calculate federal income tax, self-employment tax, quarterly estimated payments, and capital gains tax. IRS-aligned calculations.`;
const keywords =
  'us tax calculator, federal tax calculator, irs tax calculator, income tax calculator 2026, self employment tax calculator, 1099 tax calculator, quarterly tax calculator, capital gains tax calculator, tax bracket calculator';
const canonicalURL = '/calculators/us-tax';
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

const calculators = [
  {
    title: 'US Tax Bracket Calculator',
    description:
      'Find your 2026 federal tax bracket, calculate tax owed, and see your effective vs marginal rate.',
    href: '/calculators/us-tax-bracket-calculator/',
    icon: 'chart',
    color: 'blue',
  },
  {
    title: 'Self-Employment Tax Calculator',
    description:
      'Calculate 15.3% SE tax on 1099 income including Social Security, Medicare, and the 50% deduction.',
    href: '/calculators/us-self-employment-tax-calculator/',
    icon: 'calculator',
    color: 'green',
  },
  {
    title: 'Quarterly Tax Calculator',
    description:
      'Calculate 1040-ES quarterly estimated payments with safe harbor rules to avoid underpayment penalties.',
    href: '/calculators/us-quarterly-tax-calculator/',
    icon: 'calendar',
    color: 'violet',
  },
  {
    title: 'Capital Gains Tax Calculator',
    description:
      'Calculate tax on stocks, crypto, and investments. Compare short-term vs long-term rates with NIIT.',
    href: '/calculators/us-capital-gains-tax-calculator/',
    icon: 'chart',
    color: 'amber',
  },
];
---

<CategoryLayout
  category={category}
  title={title}
  description={description}
  keywords={keywords}
  canonicalURL={canonicalURL}
  icon="dollar"
  color="blue"
  tagline={`Free IRS-aligned tax calculators for the ${FEDERAL_TAX_YEAR} tax year`}
  calculators={calculators}
>
  <p>
    Our US tax calculators help you understand your federal tax liability, plan quarterly payments,
    and optimize your investment taxes. All calculations use the {FEDERAL_TAX_YEAR} IRS tax rates and
    thresholds.
  </p>
  <p>
    W-2 employees checking a tax bracket, freelancers calculating self-employment tax, and investors
    figuring out capital gains all get accurate numbers instantly.
  </p>
  <h3>{FEDERAL_TAX_YEAR} Federal Tax Brackets (Single)</h3>
  <ul>
    {
      FEDERAL_BRACKETS_2026.single.map((b) => (
        <li>
          <strong>{b.rate}%:</strong>{' '}
          {b.max === Infinity
            ? `Over ${usd(b.min)}`
            : `${usd(b.min === 0 ? 0 : b.min + 1)} - ${usd(b.max)}`}
        </li>
      ))
    }
  </ul>
  <h3>Key Tax Rates for {FEDERAL_TAX_YEAR}</h3>
  <ul>
    <li>
      <strong>Standard Deduction:</strong>
      {usd(STANDARD_DEDUCTION_2026.single)} (single), {usd(STANDARD_DEDUCTION_2026.married_jointly)} (married
      filing jointly)
    </li>
    <li><strong>Self-Employment Tax:</strong> 15.3% (12.4% Social Security + 2.9% Medicare)</li>
    <li><strong>Long-Term Capital Gains:</strong> 0%, 15%, or 20% depending on income</li>
    <li><strong>NIIT:</strong> Additional 3.8% on investment income for high earners</li>
    <li><strong>Social Security Wage Base:</strong> {usd(SOCIAL_SECURITY_WAGE_BASE_2026)}</li>
  </ul>
</CategoryLayout>
